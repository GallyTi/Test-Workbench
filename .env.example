# Server Configuration
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# PostgreSQL Database
DATABASE_URL="postgresql://rits_admin:rits_secure_pass_2026@postgres:5432/rits_workbench?schema=public"
POSTGRES_USER=rits_admin
POSTGRES_PASSWORD=rits_secure_pass_2026
POSTGRES_DB=rits_workbench

# Redis (Locks, Cache, BullMQ Queue, WebSockets)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# MinIO / S3 Object Storage (Screenshots, Excel Files)
S3_ENDPOINT=minio
S3_PORT=9000
S3_USE_SSL=false
S3_ACCESS_KEY=minio_admin
S3_SECRET_KEY=minio_secure_pass
S3_BUCKET_NAME=test-attachments
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_secure_pass

# Mail / SMTP
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="noreply@rits-workbench.local"

# Security / JWT
JWT_SECRET=super_secret_jwt_key_development_2026_change_in_prod
JWT_EXPIRATION=1d

# MS Teams Webhook
TEAMS_WEBHOOK_URL=
